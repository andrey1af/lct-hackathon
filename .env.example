# APP
HTTP_PORT=8090
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_SHUTDOWN_TIMEOUT=10s
HEALTHCHECK_TIMEOUT=2s
CORS_ALLOWED_ORIGINS=
OPENAPI_SPEC_PATH=/app/openapi.yaml

# ENV
ENV=dev

# DATABASE
DB_HOST=db
DB_PORT=5432
DB_USER=negotiation_simulator
DB_PASSWORD=
DB_NAME=negotiation_simulator
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
DB_CONN_MAX_LIFETIME=5m

# GIGACHAT
GIGACHAT_AUTH_KEY=
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1
GIGACHAT_REQUEST_TIMEOUT=30s
GIGACHAT_MAX_TOKENS=1024
GIGACHAT_TEMPERATURE=0.7

# NEGOTIATION
NEGOTIATION_DEFAULT_CASE_KEY=practice-procurement

JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
REFRESH_COOKIE_NAME=refresh_token
# For local HTTP only; use false on HTTPS deployments.
REFRESH_COOKIE_INSECURE=true
